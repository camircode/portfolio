---
import { ClientRouter } from 'astro:transitions';
import SectionNavigation from '@/components/SectionNavigation.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import '@/styles/global.css';
import { site, type Locale } from '@/data/content';

interface Props {
  title?: string;
  description?: string;
  locale: Locale;
  canonicalPath: string;
  alternatePath: string;
  image?: string;
  noindex?: boolean;
  immersive?: boolean;
  /**
   * Open Graph object type. Project and article routes should pass 'article';
   * everything else stays the default 'website'.
   */
  ogType?: 'website' | 'article';
  /**
   * Extra breadcrumb steps between the section and the current page, in order.
   * A module page passes its project: [{ name: project.title, path: projectPath(...) }].
   * Home and the section index are added automatically from canonicalPath.
   */
  breadcrumb?: readonly { name: string; path: string }[];
}

const {
  locale,
  title,
  description: providedDescription,
  canonicalPath,
  alternatePath,
  image = '/assets/og/portfolio.png',
  noindex = false,
  immersive = false,
  ogType = 'website',
  breadcrumb = [],
} = Astro.props;
const description = providedDescription ?? site.description[locale];
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Software & DevOps`;
const canonical = new URL(canonicalPath, site.domain).toString();
const alternate = new URL(alternatePath, site.domain).toString();
const ogImage = new URL(image, site.domain).toString();
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.domain,
  image: new URL('/assets/hero.webp', site.domain).toString(),
  sameAs: [site.github, site.linkedin],
  jobTitle: locale === 'es' ? 'Desarrollador de software y consultor DevOps' : 'Software developer and DevOps consultant',
  knowsAbout: [
    'Astro',
    'TypeScript',
    'Go',
    'React',
    'DevOps',
    'PostgreSQL',
    'Tauri',
    'Self-hosting',
    'Kubernetes',
    'Terraform',
    'Ansible',
    'Jenkins',
    'Argo CD',
    'GitOps',
    'Model Context Protocol',
  ],
};

const homePath = locale === 'es' ? '/' : '/en/';
const sectionPaths = locale === 'es'
  ? [{ name: 'Sobre mí', path: '/sobre-mi/' }, { name: 'Proyectos', path: '/proyectos/' }, { name: 'Tecnologías', path: '/tecnologias/' }]
  : [{ name: 'About', path: '/en/about/' }, { name: 'Projects', path: '/en/projects/' }, { name: 'Technologies', path: '/en/technologies/' }];
const section = sectionPaths.find((entry) => canonicalPath.startsWith(entry.path) && canonicalPath !== entry.path);
const breadcrumbTrail = immersive || !title
  ? []
  : [{ name: site.name, path: homePath }, ...(section ? [section] : []), ...breadcrumb, { name: title, path: canonicalPath }];
const breadcrumbSchema = breadcrumbTrail.length > 1
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbTrail.map((entry, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: entry.name,
        item: new URL(entry.path, site.domain).toString(),
      })),
    }
  : null;
---

<!doctype html>
<html lang={locale} data-immersive={immersive ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#080909" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#e9ebe4" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'es' ? 'en' : 'es'} href={alternate} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={locale === 'es' ? canonical : alternate} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'es' ? 'es_MX' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    <script is:inline data-astro-rerun>
      (() => {
        const KEY = 'camir-theme';
        const COLOR = { dark: '#080909', light: '#e9ebe4' };
        const root = document.documentElement;

        const read = () => {
          try {
            const stored = localStorage.getItem(KEY);
            return stored === 'light' || stored === 'dark' ? stored : null;
          } catch {
            return null;
          }
        };

        const apply = () => {
          const choice = read();
          if (choice) root.setAttribute('data-theme', choice);
          else root.removeAttribute('data-theme');
          root.setAttribute('data-theme-ready', '');

          document.querySelectorAll('meta[name="theme-color"]').forEach((meta, index) => {
            const scheme = index === 0 ? 'dark' : 'light';
            if (choice) {
              meta.removeAttribute('media');
              meta.setAttribute('content', COLOR[choice]);
            } else {
              meta.setAttribute('media', '(prefers-color-scheme: ' + scheme + ')');
              meta.setAttribute('content', COLOR[scheme]);
            }
          });

          /* Anything painting outside CSS — the home rack's WebGL scene — reads
             its colours back from the tokens when this fires. */
          document.dispatchEvent(new CustomEvent('camir:theme'));
        };

        apply();

        if (!window.__camirThemeBound) {
          window.__camirThemeBound = true;
          const cycle = [null, 'light', 'dark'];
          document.addEventListener('click', (event) => {
            const target = event.target;
            const toggle = target instanceof Element ? target.closest('[data-theme-toggle]') : null;
            if (!toggle) return;
            const next = cycle[(cycle.indexOf(read()) + 1) % cycle.length];
            try {
              if (next) localStorage.setItem(KEY, next);
              else localStorage.removeItem(KEY);
            } catch {}
            apply();
          });
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    <script is:inline data-astro-rerun>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-ready');
        window.clearTimeout(window.__sectionRevealFailsafe);
        window.__sectionRevealFailsafe = window.setTimeout(() => document.documentElement.classList.remove('reveal-ready'), 2500);
      }
    </script>
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body class:list={{ 'immersive-page': immersive }}>
    <a class="skip-link" href="#main-content">{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    {!immersive && <SiteHeader locale={locale} canonicalPath={canonicalPath} alternatePath={alternatePath} />}
    {!immersive && <SectionNavigation locale={locale} canonicalPath={canonicalPath} />}
    <main id="main-content">
      <slot />
    </main>
    <script>
      declare global {
        interface Window {
          __sectionRevealCleanup?: () => void;
          __sectionRevealFailsafe?: number;
        }
      }

      const revealSelector = '.project-narrative, .detail-section, .modules-section > header, .module-card, .technology-card, .index-card, .article-copy > *, .related-work, .flow-board, .module-evidence, .timeline > h2, .timeline > article, .about-bays > article';

      function initializeSectionReveals() {
        window.__sectionRevealCleanup?.();
        window.clearTimeout(window.__sectionRevealFailsafe);
        const revealRoot = document.documentElement;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (reducedMotion || document.body.classList.contains('immersive-page')) {
          revealRoot.classList.remove('reveal-ready');
          return;
        }

        revealRoot.classList.add('reveal-ready');
        const revealItems = [...document.querySelectorAll<HTMLElement>(revealSelector)];
        let revealCardIndex = 0;
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -6% 0px', threshold: 0.12 });

        revealItems.forEach((item) => {
          const isCard = item.matches('.module-card, .technology-card, .index-card, .timeline > article, .about-bays > article');
          item.style.setProperty('--reveal-delay', `${isCard ? (revealCardIndex++ % 2) * 55 : 0}ms`);
          revealObserver.observe(item);
        });
        window.__sectionRevealCleanup = () => revealObserver.disconnect();
      }

      document.addEventListener('astro:page-load', initializeSectionReveals);
      document.addEventListener('astro:before-swap', () => window.__sectionRevealCleanup?.());
    </script>
  </body>
</html>
