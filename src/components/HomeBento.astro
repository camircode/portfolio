---
import { Image } from 'astro:assets';
import hero from '@/assets/hero.png';
import BrandLogo from '@/components/BrandLogo.astro';
import { projectPath, projects, site, technologies, type Locale } from '@/data/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEs = locale === 'es';
const paths = {
  projects: isEs ? '/proyectos/' : '/en/projects/',
  technologies: isEs ? '/tecnologias/' : '/en/technologies/',
  about: isEs ? '/sobre-mi/' : '/en/about/',
  cv: isEs ? '/downloads/Carlos-Miranda-CV-es.pdf' : '/downloads/Carlos-Miranda-CV-en.pdf',
};
const technologyIconSlugs = ['html', 'css', 'astro', 'typescript', 'go', 'nodejs', 'docker', 'postgresql'];
const technologyIcons = technologyIconSlugs
  .map((slug) => technologies.find((technology) => technology.slug === slug))
  .filter((technology) => technology !== undefined);

/*
 * The featured project owns its own bay, so the work bay lists the rest. The
 * lookup is by the `featured` flag rather than by slug: whichever project
 * carries the flag gets the 3D bay, and the fallback keeps the bay populated
 * if the flag is ever dropped.
 */
const featuredProject = projects.find((project) => project.featured) ?? projects[0];
const peerProjects = projects.filter((project) => project !== featuredProject);
// The readout follows the path through the stack — hardware, orchestration,
// provisioning, configuration, build, sync — and stops before it saturates the
// bay. The rest of the stack is on the project page.
const featuredStackSlugs = ['proxmox', 'kubernetes', 'terraform', 'ansible', 'jenkins', 'argocd'];
const featuredStack = featuredStackSlugs
  .filter((slug) => featuredProject.technologies.includes(slug))
  .map((slug) => technologies.find((technology) => technology.slug === slug))
  .filter((technology) => technology !== undefined);
---

<!--
THESIS: A portfolio explored as a live operations rack, refusing the standard hero followed by a uniform project-card grid.
OWN-WORLD: Near-black equipment bays, warm readouts, one chartreuse live circuit, Array display lettering, Khand operational copy.
STORY: Meet Carlos, follow his systems into projects and technologies, inspect evidence, then contact or download the resume.
FIRST VIEWPORT: Portrait bay left, identity and project bays across the center, guided signal console and 3D server bay at right.
FORM: Pinned asymmetric bento reference, translated into an interactive Experience surface with an activation sequence and spatial route handoffs.
-->
<section class="rack-home" data-rack-home aria-labelledby="home-title">
  <script is:inline data-astro-rerun>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('boot-pending');
      window.setTimeout(() => document.documentElement.classList.remove('boot-pending'), 2500);
    }
  </script>
  <div class="boot-screen" aria-hidden="true">
    <span>CAMIR / SYSTEMS</span>
    <i></i>
  </div>

  <div class="rack-grid">
    <article class="rack-tile portrait-tile is-active is-revealed" data-rack-step="0" data-reveal-label={isEs ? '01 / Identidad activa' : '01 / Identity active'} transition:name="portrait" tabindex="0" aria-expanded="true">
      <Image
        src={hero}
        alt={isEs ? 'Retrato de Carlos Miranda' : 'Portrait of Carlos Miranda'}
        widths={[420, 640, 880]}
        sizes="(max-width: 680px) 100vw, 36vw"
        loading="eager"
        fetchpriority="high"
        quality={88}
      />
      <div class="portrait-caption">
        <p>{isEs ? 'Hola, soy' : 'Hello, I’m'}</p>
        <h1 id="home-title">Carlos Miranda</h1>
      </div>
    </article>

    <a class="rack-tile projects-tile" data-rack-step="2" data-reveal-label={isEs ? '03 / Tocar para activar trabajo' : '03 / Touch to activate work'} href={paths.projects} transition:name="projects-bay" aria-expanded="false">
      <header>
        <span class="status-label">{isEs ? 'Trabajo seleccionado' : 'Selected work'}</span>
        <span aria-hidden="true">↗</span>
      </header>
      <div class="project-stack">
        {peerProjects.map((project) => (
          <article class="project-strip">
            <h2>{project.title}</h2>
            <span>{project.period}</span>
            <p>{project.summary[locale]}</p>
          </article>
        ))}
      </div>
    </a>

    <a class="rack-tile technologies-tile" data-rack-step="3" data-reveal-label={isEs ? '04 / Tocar para activar stack' : '04 / Touch to activate stack'} href={paths.technologies} transition:name="technologies-bay" aria-expanded="false">
      <span class="technologies-link" aria-hidden="true">↗</span>
      <div class="technology-icons" aria-hidden="true">
        {technologyIcons.map((technology) => <img src={technology.logo} alt="" width="44" height="44" loading="lazy" />)}
      </div>
      <div>
        <strong>{technologies.length}</strong>
        <p>{isEs ? 'tecnologías conectadas a evidencia real' : 'technologies connected to real evidence'}</p>
      </div>
    </a>

    <a class="rack-tile about-tile" data-rack-step="1" data-reveal-label={isEs ? '02 / Tocar para activar perfil' : '02 / Touch to activate profile'} href={paths.about} transition:name="about-bay" aria-expanded="false">
      <span class="status-label">{isEs ? 'Sobre mí' : 'About'}</span>
      <blockquote>
        {isEs
          ? 'Construyo el producto, entiendo su operación y mantengo la infraestructura que lo sostiene.'
          : 'I build the product, understand its operation, and maintain the infrastructure that supports it.'}
      </blockquote>
      <span class="about-link">{isEs ? 'Abrir perfil' : 'Open profile'} <i aria-hidden="true">↗</i></span>
    </a>

    <article class="rack-tile contact-tile" data-rack-step="4" data-reveal-label={isEs ? '05 / Tocar para abrir contacto' : '05 / Touch to open contact'} tabindex="0" aria-expanded="false">
      <div>
        <span class="status-label">{isEs ? 'Siguiente paso' : 'Next step'}</span>
        <h2>{isEs ? '¿Construimos algo que deba funcionar de verdad?' : 'Shall we build something that has to work for real?'}</h2>
      </div>
      <div class="contact-actions home-contact-actions">
        <a class="button compact-home-action cv-button" href={paths.cv} download><span class="action-icon download-icon" aria-hidden="true"></span>{isEs ? 'Descargar CV' : 'Download résumé'}</a>
        <a class="button compact-home-action secondary" href={`mailto:${site.email}`}><span class="action-icon mail-icon" aria-hidden="true"></span>{isEs ? 'Correo' : 'Email'}</a>
        <a class="button compact-home-action secondary" href={site.linkedin} target="_blank" rel="noreferrer"><BrandLogo name="linkedin" /> LinkedIn</a>
        <a class="button compact-home-action secondary" href={site.github} target="_blank" rel="noreferrer"><BrandLogo name="github" /> GitHub</a>
      </div>
    </article>

    <a class="rack-tile server-tile" data-rack-step="5" data-reveal-label={isEs ? '06 / Tocar para encender la infraestructura' : '06 / Touch to power the infrastructure'} href={projectPath(featuredProject, locale)} transition:name={`${featuredProject.slug}-card`} aria-expanded="false">
      <header>
        <span class="status-label">{featuredProject.kicker[locale]}</span>
        <span aria-hidden="true">↗</span>
      </header>
      <div class="server-fallback" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i>
      </div>
      <canvas data-server-canvas aria-hidden="true"></canvas>
      <div class="server-readout">
        <h2>{featuredProject.title}</h2>
        <p>{featuredProject.summary[locale]}</p>
        <ul class="server-stack">
          {featuredStack.map((technology) => <li>{technology.name}</li>)}
        </ul>
      </div>
    </a>

    <aside class="rack-tile guide-tile">
      <div class="language-selector">
        <h2>{isEs ? 'Selecciona el idioma' : 'Choose your language'}</h2>
        <nav aria-label="Selector de idioma / Language selector">
          <a href="/" lang="es" hreflang="es" aria-current={isEs ? 'page' : undefined} data-language-option="es">
            <span>ES</span>
            <strong>Español</strong>
            <small>{isEs ? 'Activo' : 'Seleccionar'}</small>
          </a>
          <a href="/en/" lang="en" hreflang="en" aria-current={!isEs ? 'page' : undefined} data-language-option="en">
            <span>EN</span>
            <strong>English</strong>
            <small>{isEs ? 'Seleccionar' : 'Active'}</small>
          </a>
        </nav>
      </div>
    </aside>
  </div>
</section>

<script>
  import gsap from 'gsap';

  declare global {
    interface Window {
      __rackCleanup?: () => void;
    }
  }

  async function createServerScene(canvas: HTMLCanvasElement, reducedMotion: boolean) {
    const {
      WebGLRenderer,
      Scene,
      PerspectiveCamera,
      Group,
      Mesh,
      BoxGeometry,
      MeshStandardMaterial,
      MeshBasicMaterial,
      AmbientLight,
      DirectionalLight,
    } = await import('three');
    let renderer: import('three').WebGLRenderer;
    try {
      renderer = new WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: 'low-power' });
    } catch {
      return null;
    }

    const tile = canvas.closest<HTMLElement>('.server-tile');

    /*
     * The rack in the render is equipment standing in a room, so its metal and
     * its lighting come from the theme rather than from six hex literals. The
     * scene tokens hold light-dark() pairs, which only resolve on a real colour
     * property, so a hidden probe carries each one through `color` and hands
     * back the computed rgb(). The live status lights are read too, from
     * --signal-fill, which is acid in both themes by design.
     */
    const tokenProbe = document.createElement('span');
    tokenProbe.style.display = 'none';
    (tile ?? canvas).append(tokenProbe);
    const readColor = (token: string, fallback: string) => {
      tokenProbe.style.color = `var(${token}, ${fallback})`;
      const resolved = getComputedStyle(tokenProbe).color;
      return resolved.startsWith('rgb') ? resolved : fallback;
    };

    const scene = new Scene();
    const camera = new PerspectiveCamera(34, 1, 0.1, 100);
    camera.position.set(4.0, 2.7, 7.4);
    camera.lookAt(0, 0, 0);
    const group = new Group();
    group.position.x = -0.22;
    scene.add(group);

    /*
     * The bay is the homelab, so the rack is built as its topology rather than
     * as seven identical slots: three control-plane members over two worker
     * bays, a data pair joined by its replication link, and the observability
     * bay standing outside the frame it watches.
     */
    const frameMaterial = new MeshStandardMaterial({ roughness: 0.62, metalness: 0.58 });
    const frame = new Mesh(new BoxGeometry(2.8, 3.6, 1.55), frameMaterial);
    group.add(frame);

    const bayMaterial = new MeshStandardMaterial({ roughness: 0.35, metalness: 0.72 });
    const nodeMaterial = new MeshStandardMaterial({ roughness: 0.3, metalness: 0.68 });
    const lightMaterial = new MeshBasicMaterial();
    const linkMaterial = new MeshStandardMaterial({ roughness: 0.4, metalness: 0.3 });
    const addBay = (width: number, height: number, x: number, y: number, material: import('three').Material, lit: boolean) => {
      const bay = new Mesh(new BoxGeometry(width, height, 0.11), material);
      bay.position.set(x, y, 0.83);
      group.add(bay);
      if (!lit) return;
      const light = new Mesh(new BoxGeometry(0.14, 0.05, 0.035), lightMaterial);
      light.position.set(x + width / 2 - 0.16, y, 0.9);
      group.add(light);
    };

    // Control plane: three members sharing etcd and one virtual address.
    [-0.8, 0, 0.8].forEach((x) => addBay(0.72, 0.4, x, 1.36, nodeMaterial, true));
    // Worker bays behind the Gateway.
    addBay(2.45, 0.34, 0, 0.78, bayMaterial, true);
    addBay(2.45, 0.34, 0, 0.36, bayMaterial, false);
    // The primary and its streaming standby, with the replication link visible.
    [-0.62, 0.62].forEach((x) => addBay(1.1, 0.42, x, -0.28, nodeMaterial, false));
    const replication = new Mesh(new BoxGeometry(0.16, 0.06, 0.06), lightMaterial);
    replication.position.set(0, -0.28, 0.9);
    group.add(replication);
    // Delivery: the Gateway plate the whole rack answers through.
    addBay(2.45, 0.22, 0, -0.86, bayMaterial, true);

    // Observability sits outside the cluster it watches, wired back to it.
    const probe = new Mesh(new BoxGeometry(0.72, 0.56, 0.56), nodeMaterial);
    probe.position.set(2.02, -1.24, 0.4);
    group.add(probe);
    const scrape = new Mesh(new BoxGeometry(1.15, 0.055, 0.055), linkMaterial);
    scrape.position.set(1.42, -0.98, 0.62);
    scrape.rotation.z = 0.46;
    group.add(scrape);

    const ambient = new AmbientLight(0xffffff, 2.6);
    scene.add(ambient);
    const key = new DirectionalLight(0xffffff, 4.4);
    key.position.set(3, 4, 5);
    scene.add(key);

    const applyTheme = () => {
      frameMaterial.color.setStyle(readColor('--scene-frame', '#20251f'));
      bayMaterial.color.setStyle(readColor('--scene-bay', '#444d43'));
      nodeMaterial.color.setStyle(readColor('--scene-node', '#5c6659'));
      linkMaterial.color.setStyle(readColor('--scene-link', '#8fae2e'));
      lightMaterial.color.setStyle(readColor('--signal-fill', '#d7ff4f'));
      ambient.color.setStyle(readColor('--scene-ambient', '#eaf3e8'));
      key.color.setStyle(readColor('--scene-key', '#d7ff4f'));
      renderer.render(scene, camera);
    };
    applyTheme();

    let frameId = 0;
    /*
     * The canvas covers the whole bay, but the header and the readout sit on
     * top of it. The rack is fitted to the band they leave free — measured, not
     * assumed — so the control plane is never cropped off the top on a short
     * viewport and the topology stays readable at every tile proportion.
     */
    const readout = tile?.querySelector<HTMLElement>('.server-readout');
    const header = tile?.querySelector<HTMLElement>('header');
    const viewHeight = 5.55; // world units spanning the canvas height at the rack
    const rackHeight = 3.7;
    const rackWidth = 4.1;
    const resize = () => {
      const width = canvas.clientWidth || 320;
      const height = canvas.clientHeight || 260;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();

      const topBand = (header?.offsetHeight ?? 24) + 22;
      const bottomBand = readout?.offsetHeight ?? 150;
      const free = Math.max(90, height - topBand - bottomBand);
      const fitHeight = (viewHeight * (free / height)) / rackHeight;
      const fitWidth = (viewHeight * camera.aspect) / rackWidth;
      group.scale.setScalar(Math.min(1.05, Math.max(0.42, Math.min(fitHeight, fitWidth))));
      group.position.y = (height / 2 - (topBand + free / 2)) * (viewHeight / height);
    };
    const render = (time = 0) => {
      if (!reducedMotion) group.rotation.y = -0.35 + Math.sin(time * 0.00035) * 0.12;
      renderer.render(scene, camera);
      if (!canvas.dataset.serverReady) {
        canvas.dataset.serverReady = 'true';
        tile?.classList.add('has-server-scene');
      }
      if (!reducedMotion) frameId = requestAnimationFrame(render);
    };
    /*
     * A theme can change while the rack is on screen: the header toggle fires
     * camir:theme, and the system preference moves on its own when nothing is
     * stored. Both update the existing materials; nothing is rebuilt.
     */
    const schemeQuery = window.matchMedia('(prefers-color-scheme: dark)');
    schemeQuery.addEventListener('change', applyTheme);
    document.addEventListener('camir:theme', applyTheme);
    const resizeObserver = new ResizeObserver(resize);
    const handleContextLost = (event: Event) => {
      event.preventDefault();
      cancelAnimationFrame(frameId);
      delete canvas.dataset.serverReady;
      tile?.classList.remove('has-server-scene');
    };
    resize();
    render();
    resizeObserver.observe(canvas);
    canvas.addEventListener('webglcontextlost', handleContextLost);
    return () => {
      cancelAnimationFrame(frameId);
      resizeObserver.disconnect();
      schemeQuery.removeEventListener('change', applyTheme);
      document.removeEventListener('camir:theme', applyTheme);
      tokenProbe.remove();
      canvas.removeEventListener('webglcontextlost', handleContextLost);
      delete canvas.dataset.serverReady;
      tile?.classList.remove('has-server-scene');
      renderer.dispose();
      scene.traverse((object) => {
        if (object instanceof Mesh) {
          object.geometry.dispose();
          const materials = Array.isArray(object.material) ? object.material : [object.material];
          materials.forEach((material) => material.dispose());
        }
      });
    };
  }

  function initializeRack() {
    window.__rackCleanup?.();
    const root = document.querySelector<HTMLElement>('[data-rack-home]');
    if (!root) return;
    document.documentElement.classList.add('js');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-rack-step]')]
      .sort((a, b) => Number(a.dataset.rackStep) - Number(b.dataset.rackStep));
    const revealed = new Set<number>([0]);
    const controller = new AbortController();

    const canvas = root.querySelector<HTMLCanvasElement>('[data-server-canvas]');
    let active = true;
    let serverStarted = false;
    let disposeServer = () => {};
    const startServer = () => {
      if (!canvas || reducedMotion || serverStarted) return;
      serverStarted = true;
      void createServerScene(canvas, reducedMotion)
        .then((dispose) => {
          if (!dispose) {
            serverStarted = false;
            return;
          }
          if (active) disposeServer = dispose;
          else dispose();
        })
        .catch(() => {
          serverStarted = false;
        });
    };

    const updateGuide = (index: number) => {
      steps.forEach((step, stepIndex) => step.classList.toggle('is-active', stepIndex === index));
    };

    const reveal = (index: number) => {
      if (revealed.has(index)) return false;
      const step = steps[index];
      revealed.add(index);
      step.classList.add('is-revealed');
      step.setAttribute('aria-expanded', 'true');
      if (index === 5) startServer();

      if (!reducedMotion) {
        const content = step.querySelectorAll<HTMLElement>(':scope > *');
        gsap.fromTo(step, { clipPath: 'inset(0 0 100% 0)', scale: 0.985 }, { clipPath: 'inset(0% 0 0% 0)', scale: 1, duration: 0.72, ease: 'expo.out', clearProps: 'clipPath,scale' });
        gsap.fromTo(content, { autoAlpha: 0, y: 18, filter: 'blur(8px)' }, { autoAlpha: 1, y: 0, filter: 'blur(0px)', duration: 0.58, stagger: 0.035, ease: 'expo.out', clearProps: 'all' });
      }

      const nextIndex = steps.findIndex((_, stepIndex) => !revealed.has(stepIndex));
      updateGuide(nextIndex === -1 ? 5 : index);
      return true;
    };

    steps.forEach((step, index) => {
      if (index !== 0) step.classList.remove('is-revealed');
      step.setAttribute('aria-expanded', index === 0 ? 'true' : 'false');
      step.addEventListener('focusin', () => {
        if (revealed.has(index)) updateGuide(index);
      }, { signal: controller.signal });
      step.addEventListener('click', (event) => {
        if (revealed.has(index)) return;
        event.preventDefault();
        event.stopPropagation();
        reveal(index);
      }, { signal: controller.signal });
      if (!(step instanceof HTMLAnchorElement)) {
        step.addEventListener('keydown', (event) => {
          if (revealed.has(index) || (event.key !== 'Enter' && event.key !== ' ')) return;
          event.preventDefault();
          reveal(index);
        }, { signal: controller.signal });
      }
    });

    updateGuide(0);

    const boot = root.querySelector<HTMLElement>('.boot-screen');
    const bootPending = document.documentElement.classList.contains('boot-pending');
    if (!reducedMotion && bootPending) {
      const bootFailsafe = window.setTimeout(() => {
        boot?.remove();
        document.documentElement.classList.remove('boot-pending');
      }, 2500);
      const timeline = gsap.timeline({ defaults: { ease: 'expo.out' } });
      timeline
        .fromTo('.boot-screen i', { scaleX: 0 }, { scaleX: 1, duration: 0.65, transformOrigin: 'left' })
        .to('.boot-screen', { clipPath: 'inset(0 0 100% 0)', duration: 0.8 }, '+=0.1')
        .fromTo('.rack-tile', { clipPath: 'inset(100% 0 0 0)', y: 28 }, { clipPath: 'inset(0% 0 0 0)', y: 0, duration: 0.85, stagger: 0.055, onComplete: () => {
          window.clearTimeout(bootFailsafe);
          boot?.remove();
          document.documentElement.classList.remove('boot-pending');
        } }, '-=0.45');
    } else {
      boot?.remove();
      document.documentElement.classList.remove('boot-pending');
    }

    window.__rackCleanup = () => {
      active = false;
      controller.abort();
      disposeServer();
      document.documentElement.classList.remove('boot-pending');
    };
  }

  document.addEventListener('astro:page-load', initializeRack);
  document.addEventListener('astro:before-swap', () => window.__rackCleanup?.());
  initializeRack();
</script>

<style>
  .rack-home {
    width: 100%;
    height: 100svh;
    min-height: 620px;
    margin: 0;
    padding: 10px;
    overflow: hidden;

    /*
     * The WebGL rack's own palette, declared here so it moves with the theme
     * like every other surface. Dark is the base declaration and the fallback
     * for browsers without light-dark(), matching global.css. The live status
     * lights are not here: they read --signal-fill and stay acid in both
     * rooms.
     */
    --scene-frame: #20251f;
    --scene-bay: #444d43;
    --scene-node: #5c6659;
    --scene-link: #8fae2e;
    --scene-ambient: #eaf3e8;
    --scene-key: #d7ff4f;
  }

  @supports (color: light-dark(#fff, #000)) {
    .rack-home {
      --scene-frame: light-dark(#6a7265, #20251f);
      --scene-bay: light-dark(#848c7d, #444d43);
      --scene-node: light-dark(#969e8e, #5c6659);
      --scene-link: light-dark(#5e7318, #8fae2e);
      --scene-ambient: light-dark(#f4f6ee, #eaf3e8);
      /* The rack is raked by acid in the dark room and by daylight in the lit
         one. Only the key changes: the status lights stay --signal-fill. */
      --scene-key: light-dark(#fbfdf4, #d7ff4f);
    }
  }

  .boot-screen {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: none;
    place-content: center;
    gap: 20px;
    background: var(--surface);
    color: var(--muted);
    letter-spacing: 0.12em;
  }

  :global(.boot-pending) .boot-screen {
    display: grid;
  }

  .boot-screen i {
    width: min(280px, 70vw);
    height: 3px;
    background: var(--signal);
  }

  .rack-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(6, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .rack-tile {
    position: relative;
    overflow: hidden;
    min-width: 0;
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow-panel);
    transition: background 420ms var(--ease-out), box-shadow 260ms ease;
  }

  :global(.js) .rack-tile[data-rack-step] {
    cursor: pointer;
  }

  :global(.js) .rack-tile[data-rack-step]:not(.is-revealed) {
    background: var(--surface-sunken);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  :global(.js) .rack-tile[data-rack-step]:not(.is-revealed) > * {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
  }

  :global(.js) .rack-tile[data-rack-step]:not(.is-revealed)::before {
    position: absolute;
    z-index: 5;
    top: 50%;
    left: 50%;
    width: max-content;
    max-width: calc(100% - 36px);
    color: var(--muted);
    content: attr(data-reveal-label);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
    transform: translate(-50%, -50%);
  }

  :global(.js) .rack-tile[data-rack-step]:not(.is-revealed)::after {
    position: absolute;
    z-index: 5;
    right: 16px;
    bottom: 16px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line);
    content: '';
